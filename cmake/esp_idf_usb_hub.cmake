# IDF 4.4.7 clears the hub pointer before hcd_port_deinit disables the ISR.
# A root-port interrupt in that window dereferences NULL. Keep the hub alive
# until interrupts are disabled. The host also tears down on its install core.
idf_component_get_property(usb_target usb COMPONENT_LIB)
get_target_property(usb_sources ${usb_target} SOURCES)
get_target_property(usb_dir ${usb_target} SOURCE_DIR)
set(hub_found FALSE)
foreach(source IN LISTS usb_sources)
    get_filename_component(source_path "${source}" ABSOLUTE BASE_DIR "${usb_dir}")
    if(source_path MATCHES "/components/usb/hub\\.c$")
        set(hub_found TRUE)
        file(READ "${source_path}" original)
        set(before "    hub_driver_t *hub_driver_obj = p_hub_driver_obj;\n    p_hub_driver_obj = NULL;\n    HUB_DRIVER_EXIT_CRITICAL();\n\n    ESP_ERROR_CHECK(hcd_port_deinit(hub_driver_obj->constant.root_port_hdl));")
        set(after "    hub_driver_t *hub_driver_obj = p_hub_driver_obj;\n    HUB_DRIVER_EXIT_CRITICAL();\n\n    ESP_ERROR_CHECK(hcd_port_deinit(hub_driver_obj->constant.root_port_hdl));\n    HUB_DRIVER_ENTER_CRITICAL();\n    p_hub_driver_obj = NULL;\n    HUB_DRIVER_EXIT_CRITICAL();")
        string(FIND "${original}" "${before}" patch_position)
        if(patch_position EQUAL -1)
            message(FATAL_ERROR "ESP-IDF USB hub changed; review the interrupt teardown compatibility patch")
        endif()
        string(REPLACE "${before}" "${after}" patched "${original}")
        set(destination "${CMAKE_BINARY_DIR}/framework-patches/hub.c")
        file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/framework-patches")
        set(existing "")
        if(EXISTS "${destination}")
            file(READ "${destination}" existing)
        endif()
        if(NOT patched STREQUAL existing)
            file(WRITE "${destination}" "${patched}")
        endif()
        list(REMOVE_ITEM usb_sources "${source}")
        list(APPEND usb_sources "${destination}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_path}")
    endif()
endforeach()
if(NOT hub_found)
    message(FATAL_ERROR "ESP-IDF USB hub source missing; compatibility patch was not applied")
endif()
set_property(TARGET ${usb_target} PROPERTY SOURCES "${usb_sources}")
