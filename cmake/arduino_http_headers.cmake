# Bound header parsing without changing Stream or multipart/body reads globally.
idf_component_get_property(arduino_target framework-arduinoespressif32 COMPONENT_LIB)
get_target_property(arduino_sources ${arduino_target} SOURCES)
get_target_property(arduino_dir ${arduino_target} SOURCE_DIR)
set(parser_found FALSE)
foreach(source IN LISTS arduino_sources)
    get_filename_component(source_path "${source}" ABSOLUTE BASE_DIR "${arduino_dir}")
    if(source_path MATCHES "/libraries/WebServer/src/Parsing\\.cpp$")
        if(parser_found)
            message(FATAL_ERROR "Multiple Arduino HTTP parsers; review the header compatibility patch")
        endif()
        set(parser_found TRUE)
        file(READ "${source_path}" original)
        set(first "  String req = client.readStringUntil('\\r');\n  client.readStringUntil('\\n');")
        set(headers "      req = client.readStringUntil('\\r');\n      client.readStringUntil('\\n');")
        string(FIND "${original}" "${first}" first_position)
        string(FIND "${original}" "${headers}" headers_position)
        string(LENGTH "${original}" original_length)
        string(REPLACE "${first}" "" without_first "${original}")
        string(REPLACE "${headers}" "" without_headers "${original}")
        string(LENGTH "${without_first}" without_first_length)
        string(LENGTH "${without_headers}" without_headers_length)
        string(LENGTH "${first}" first_length)
        string(LENGTH "${headers}" headers_length)
        math(EXPR removed_first "${original_length} - ${without_first_length}")
        math(EXPR removed_headers "${original_length} - ${without_headers_length}")
        math(EXPR expected_headers "2 * ${headers_length}")
        if(first_position EQUAL -1 OR headers_position EQUAL -1 OR
           NOT removed_first EQUAL first_length OR NOT removed_headers EQUAL expected_headers)
            message(FATAL_ERROR "Arduino HTTP parser changed; review the header compatibility patch")
        endif()
        set(read_line "headerReader.readLine(client, req, []() { return millis(); }, []() { delay(1); })")
        string(REPLACE "${first}" "  RadProHttp::HeaderReader headerReader(millis());\n  String req;\n  if (!${read_line}) return false;" patched "${original}")
        string(REPLACE "${headers}" "      if (!${read_line}) return false;" patched "${patched}")
        set(patched "#include \"HttpHeaderReader.h\"\n${patched}")
        set(destination "${CMAKE_BINARY_DIR}/framework-patches/Parsing.cpp")
        file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/framework-patches")
        configure_file("${CMAKE_CURRENT_LIST_DIR}/../lib/AppSupport/Http/HttpHeaderReader.h"
                       "${CMAKE_BINARY_DIR}/framework-patches/HttpHeaderReader.h" COPYONLY)
        set(existing "")
        if(EXISTS "${destination}")
            file(READ "${destination}" existing)
        endif()
        if(NOT patched STREQUAL existing)
            file(WRITE "${destination}" "${patched}")
        endif()
        list(REMOVE_ITEM arduino_sources "${source}")
        list(APPEND arduino_sources "${destination}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_path}")
    endif()
endforeach()
if(NOT parser_found)
    message(FATAL_ERROR "Arduino HTTP parser missing; header compatibility patch was not applied")
endif()
set_property(TARGET ${arduino_target} PROPERTY SOURCES "${arduino_sources}")
