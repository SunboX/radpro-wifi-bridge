# Mirror actual panic output into RTC RAM; the normal panic output is unchanged.
idf_component_get_property(system_target esp_system COMPONENT_LIB)
get_target_property(system_sources ${system_target} SOURCES)
get_target_property(system_dir ${system_target} SOURCE_DIR)
set(panic_found FALSE)
foreach(source IN LISTS system_sources)
    get_filename_component(source_path "${source}" ABSOLUTE BASE_DIR "${system_dir}")
    if(source_path MATCHES "/components/esp_system/panic\\.c$")
        set(panic_found TRUE)
        file(READ "${source_path}" original)
        set(before "void panic_print_char(const char c)\n{")
        set(after "extern void radpro_panic_capture_char(char c);\nvoid panic_print_char(const char c)\n{\n    radpro_panic_capture_char(c);")
        string(FIND "${original}" "${before}" position)
        if(position EQUAL -1)
            message(FATAL_ERROR "ESP-IDF panic printer changed; review the retained capture patch")
        endif()
        string(REPLACE "${before}" "${after}" patched "${original}")
        set(destination "${CMAKE_BINARY_DIR}/framework-patches/panic.c")
        file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/framework-patches")
        set(existing "")
        if(EXISTS "${destination}")
            file(READ "${destination}" existing)
        endif()
        if(NOT patched STREQUAL existing)
            file(WRITE "${destination}" "${patched}")
        endif()
        list(REMOVE_ITEM system_sources "${source}")
        list(APPEND system_sources "${destination}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_path}")
    endif()
endforeach()
if(NOT panic_found)
    message(FATAL_ERROR "ESP-IDF panic source missing; retained capture was not installed")
endif()
set_property(TARGET ${system_target} PROPERTY SOURCES "${system_sources}")
